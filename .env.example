# Solo protocolo+host(+puerto) del backend (Spring Boot), SIN /api y SIN el
# prefijo de tenant: ambos los agrega tenantInterceptor.ts en cada request,
# porque el prefijo (/SICANETSC/PLD/{tenantId}) depende del tenant activo,
# que sale de la URL del front (:tenantId en routes/router.tsx), no de env.
VITE_API_BASE_URL=http://localhost:8080

# URL del documento OpenAPI/Swagger del backend, usada por `pnpm gen:api`.
VITE_API_DOCS_URL=http://localhost:8080/v3/api-docs

# Cloudflare Turnstile Site Key (Widget público)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFQ8vnh6fwrcIhwL

